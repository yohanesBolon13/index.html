<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trigonometri: Konsep dan Dasar-Dasarnya</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Literata:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f2f6fb; --surface:#ffffff; --ink:#13203a; --muted:#53617c; --line:#c9d5e6;
  --sin:#1f5fe0; --cos:#e0562b; --tan:#15936a; --grid:#dbe5f2;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0e1628; --surface:#16213a; --ink:#e8eefb; --muted:#a2b0cc; --line:#2c3b5c; --sin:#6b9bff; --cos:#ff8a5f; --tan:#43d1a1; --grid:#1c2a47;}
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Literata',Georgia,serif;font-size:1.05rem;line-height:1.75;
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:32px 32px}
h1,h2,h3,nav,button,label,th{font-family:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif}
a{color:inherit}
:focus-visible{outline:3px solid var(--sin);outline-offset:2px}
nav{position:sticky;top:0;z-index:5;display:flex;gap:1.25rem;flex-wrap:wrap;padding:.7rem 1.25rem;background:var(--surface);border-bottom:1px solid var(--line);font-weight:500;font-size:.95rem}
nav a{text-decoration:none;color:var(--muted)} nav a:hover{color:var(--ink)}
nav b{margin-right:auto;font-weight:800;color:var(--ink)}
.wrap{max-width:1040px;margin:0 auto;padding:0 1.25rem}
.hero{display:grid;grid-template-columns:1.05fr 1fr;gap:2rem;align-items:center;padding:3rem 0 2.5rem}
h1{font-size:clamp(2.4rem,6vw,4.2rem);line-height:1.02;margin:0 0 1rem;font-weight:800;letter-spacing:-.02em}
.lead{color:var(--muted);max-width:34rem;margin:0 0 1.5rem}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:1.25rem}
.circle-panel svg{width:100%;height:auto;display:block}
.slider{display:flex;align-items:center;gap:.75rem;margin-top:.5rem}
.slider input{flex:1;accent-color:var(--sin)}
.vals{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-top:.75rem;text-align:center;font-family:'Bricolage Grotesque',sans-serif}
.vals div{border:1px solid var(--line);border-radius:8px;padding:.35rem .2rem;font-size:.85rem;color:var(--muted)}
.vals strong{display:block;font-size:1.15rem;color:var(--ink)}
.s{color:var(--sin)}.c{color:var(--cos)}.t{color:var(--tan)}
.vals .s strong{color:var(--sin)}.vals .c strong{color:var(--cos)}.vals .t strong{color:var(--tan)}
section{padding:2.5rem 0;border-top:1px solid var(--line)}
h2{font-size:clamp(1.7rem,4vw,2.4rem);margin:0 0 .75rem;letter-spacing:-.01em}
h3{margin:1.5rem 0 .4rem;font-size:1.2rem}
p{max-width:44rem;margin:.5rem 0}
.two{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start}
.formula{display:flex;gap:.75rem;flex-wrap:wrap;margin:1rem 0}
.formula div{flex:1 1 150px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:.8rem 1rem;font-family:'Bricolage Grotesque',sans-serif;font-size:1.2rem;font-weight:700}
.formula small{display:block;font-weight:500;font-size:.85rem;color:var(--muted)}
.mnemonic{background:var(--ink);color:var(--bg);border-radius:10px;padding:.9rem 1.1rem;max-width:44rem;margin:1rem 0}
table{border-collapse:collapse;width:100%;background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow:hidden;text-align:center}
th,td{padding:.55rem .6rem;border-bottom:1px solid var(--line)}
th{background:var(--grid);font-weight:700}
.scroll{overflow-x:auto}
label{font-weight:500;font-size:.95rem}
input[type=number]{width:5.5rem;padding:.4rem;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);font:inherit}
.row{display:flex;gap:1rem;flex-wrap:wrap;margin:.6rem 0}
.out{font-family:'Bricolage Grotesque',sans-serif;line-height:1.9}
button{font-weight:700;border:0;border-radius:8px;padding:.55rem 1rem;background:var(--sin);color:#fff;cursor:pointer;font-size:.95rem}
button.alt{background:var(--surface);color:var(--ink);border:1px solid var(--line);margin:.2rem .3rem .2rem 0}
button.alt.ok{background:var(--tan);color:#fff;border-color:var(--tan)} button.alt.no{background:var(--cos);color:#fff;border-color:var(--cos)}
.q{margin:1rem 0;padding:1rem;background:var(--surface);border:1px solid var(--line);border-radius:10px}
.q p{margin:0 0 .5rem;font-weight:600}
footer{padding:2rem 0 3rem;color:var(--muted);font-size:.9rem;border-top:1px solid var(--line)}
@media(max-width:800px){.hero,.two{grid-template-columns:1fr}nav b{flex-basis:100%}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<nav aria-label="Navigasi utama"><b>Trigonometri</b><a href="#konsep">Konsep dasar</a><a href="#rasio">Sin, cos, tan</a><a href="#istimewa">Sudut istimewa</a><a href="#identitas">Identitas</a><a href="#kuis">Kuis</a></nav>

<main class="wrap">
<header class="hero">
  <div>
    <h1>Trigonometri: mengukur segitiga lewat sudutnya</h1>
    <p class="lead">Trigonometri menghubungkan besar sudut dengan perbandingan panjang sisi. Dari menaksir tinggi pohon sampai membaca gelombang suara, semuanya berawal dari segitiga siku-siku. Geser sudut di lingkaran satuan dan lihat nilainya berubah langsung.</p>
    <a href="#konsep"><button type="button">Mulai belajar</button></a>
  </div>
  <div class="panel circle-panel">
    <svg viewBox="-150 -140 300 280" role="img" aria-label="Lingkaran satuan interaktif">
      <line x1="-130" y1="0" x2="130" y2="0" stroke="var(--line)"/><line x1="0" y1="-125" x2="0" y2="125" stroke="var(--line)"/>
      <circle r="100" fill="none" stroke="var(--ink)" stroke-width="1.5"/>
      <path id="arc" fill="none" stroke="var(--muted)" stroke-width="2"/>
      <line id="sinL" stroke="var(--sin)" stroke-width="4" stroke-linecap="round"/>
      <line id="cosL" stroke="var(--cos)" stroke-width="4" stroke-linecap="round"/>
      <line id="rad" x1="0" y1="0" stroke="var(--ink)" stroke-width="2"/>
      <circle id="pt" r="6" fill="var(--ink)"/>
      <text x="104" y="-6" fill="var(--muted)" font-size="11">1</text>
    </svg>
    <div class="slider"><label for="ang">Sudut θ</label><input id="ang" type="range" min="0" max="360" value="40"><b id="angv" style="font-family:'Bricolage Grotesque',sans-serif">40°</b></div>
    <div class="vals"><div class="s">sin θ<strong id="vs"></strong></div><div class="c">cos θ<strong id="vc"></strong></div><div class="t">tan θ<strong id="vt"></strong></div><div>radian<strong id="vr"></strong></div></div>
  </div>
</header>

<section id="konsep">
  <h2>Konsep dasar</h2>
  <p>Trigonometri berasal dari bahasa Yunani: <i>trigonon</i> (segitiga) dan <i>metron</i> (ukuran). Objek utamanya adalah segitiga siku-siku, yaitu segitiga dengan satu sudut 90°.</p>
  <div class="two">
    <div>
      <h3>Nama-nama sisi</h3>
      <p>Pada segitiga siku-siku, pilih satu sudut lancip sebagai acuan (θ). Nama sisi bergantung pada sudut acuan itu:</p>
      <p><b>Sisi miring</b> (hipotenusa): sisi terpanjang, berhadapan dengan sudut 90°.<br>
      <b>Sisi depan</b>: sisi yang berhadapan dengan sudut θ.<br>
      <b>Sisi samping</b>: sisi yang menempel pada θ selain sisi miring.</p>
      <p>Ketiga sisi terhubung oleh teorema Pythagoras: <b>depan² + samping² = miring²</b>.</p>
    </div>
    <div class="panel">
      <svg viewBox="0 0 260 190" role="img" aria-label="Segitiga siku-siku dengan sisi depan, samping, dan miring" style="width:100%;height:auto">
        <polygon points="30,160 220,160 220,30" fill="var(--grid)" stroke="var(--ink)" stroke-width="2"/>
        <path d="M205 160 v-15 h15" fill="none" stroke="var(--ink)"/>
        <path d="M70 160 A40 40 0 0 0 64 143" fill="none" stroke="var(--muted)" stroke-width="2"/>
        <text x="80" y="153" fill="var(--ink)" font-size="15">θ</text>
        <text x="100" y="182" fill="var(--cos)" font-size="14" font-weight="700">samping</text>
        <text x="226" y="100" fill="var(--sin)" font-size="14" font-weight="700">depan</text>
        <text x="95" y="86" fill="var(--tan)" font-size="14" font-weight="700" transform="rotate(-34 95 86)">miring</text>
      </svg>
    </div>
  </div>
  <h3>Sudut: derajat dan radian</h3>
  <p>Satu putaran penuh adalah 360°, atau 2π radian. Jadi 180° = π rad, dan untuk mengubah derajat ke radian kalikan dengan π/180.</p>
</section>

<section id="rasio">
  <h2>Perbandingan trigonometri</h2>
  <p>Tiga perbandingan utama membandingkan dua sisi segitiga siku-siku. Nilainya hanya bergantung pada sudut, bukan pada ukuran segitiga.</p>
  <div class="formula">
    <div class="s">sin θ = depan / miring<small>sinus</small></div>
    <div class="c">cos θ = samping / miring<small>kosinus</small></div>
    <div class="t">tan θ = depan / samping<small>tangen</small></div>
  </div>
  <div class="mnemonic">Pengingat: <b>SOH-CAH-TOA</b>. Sin = Opposite/Hypotenuse, Cos = Adjacent/Hypotenuse, Tan = Opposite/Adjacent. Dalam bahasa Indonesia: <b>Sin-De-Mi, Cos-Sa-Mi, Tan-De-Sa</b>.</div>
  <p>Kebalikannya: cosecant (csc) = 1/sin, secant (sec) = 1/cos, dan cotangent (cot) = 1/tan.</p>

  <h3>Coba hitung sendiri</h3>
  <div class="panel">
    <div class="row">
      <label>Sisi depan <input id="a" type="number" value="3" min="0.1" step="0.1"></label>
      <label>Sisi samping <input id="b" type="number" value="4" min="0.1" step="0.1"></label>
    </div>
    <div class="out" id="calc"></div>
  </div>
</section>

<section id="istimewa">
  <h2>Sudut istimewa</h2>
  <p>Lima sudut ini muncul terus di soal dan perlu dihafal. Pola sin: √0/2, √1/2, √2/2, √3/2, √4/2. Cos adalah urutan sebaliknya.</p>
  <div class="scroll"><table>
    <tr><th>θ</th><th>0°</th><th>30°</th><th>45°</th><th>60°</th><th>90°</th></tr>
    <tr><th class="s">sin</th><td>0</td><td>1/2</td><td>½√2</td><td>½√3</td><td>1</td></tr>
    <tr><th class="c">cos</th><td>1</td><td>½√3</td><td>½√2</td><td>1/2</td><td>0</td></tr>
    <tr><th class="t">tan</th><td>0</td><td>⅓√3</td><td>1</td><td>√3</td><td>tak terdefinisi</td></tr>
  </table></div>
  <h3>Tanda di tiap kuadran</h3>
  <p>Di lingkaran satuan, cos adalah koordinat x dan sin adalah koordinat y. Karena itu: kuadran I semua positif, kuadran II hanya sin positif, kuadran III hanya tan positif, dan kuadran IV hanya cos positif. Coba geser sudut di atas dan amati tandanya.</p>
</section>

<section id="identitas">
  <h2>Identitas dasar</h2>
  <p>Titik pada lingkaran satuan memenuhi x² + y² = 1. Karena x = cos θ dan y = sin θ, kita dapatkan identitas paling penting:</p>
  <div class="formula">
    <div>sin²θ + cos²θ = 1</div>
    <div>tan θ = sin θ / cos θ</div>
    <div>1 + tan²θ = sec²θ</div>
  </div>
  <p>Identitas ini memungkinkan kita mencari sin, cos, atau tan jika salah satunya sudah diketahui. Contoh: jika sin θ = 3/5 dan θ lancip, maka cos θ = √(1 − 9/25) = 4/5.</p>
</section>

<section id="kuis">
  <h2>Kuis singkat</h2>
  <div id="quiz"></div>
</section>
</main>

<footer><div class="wrap">Materi trigonometri dasar untuk pelajar SMA/SMK. Sumber visual dibuat langsung dengan SVG dan JavaScript.</div></footer>

<script>
const $=id=>document.getElementById(id), f=(n,d=3)=>(Math.abs(n)<1e-9?0:+n.toFixed(d)).toString().replace('.',',');
const ang=$('ang');
function drawCircle(){
  const d=+ang.value, r=d*Math.PI/180, R=100, x=R*Math.cos(r), y=-R*Math.sin(r);
  $('angv').textContent=d+'°';
  $('pt').setAttribute('cx',x);$('pt').setAttribute('cy',y);
  $('rad').setAttribute('x2',x);$('rad').setAttribute('y2',y);
  $('sinL').setAttribute('x1',x);$('sinL').setAttribute('y1',0);$('sinL').setAttribute('x2',x);$('sinL').setAttribute('y2',y);
  $('cosL').setAttribute('x1',0);$('cosL').setAttribute('y1',0);$('cosL').setAttribute('x2',x);$('cosL').setAttribute('y2',0);
  const ax=26*Math.cos(r), ay=-26*Math.sin(r);
  $('arc').setAttribute('d',d<=0?'':`M26 0 A26 26 0 ${d>180?1:0} 0 ${ax} ${ay}`);
  $('vs').textContent=f(Math.sin(r));$('vc').textContent=f(Math.cos(r));
  $('vt').textContent=(d%180===90)?'tak terdef.':f(Math.tan(r));
  $('vr').textContent=f(r,2);
}
ang.addEventListener('input',drawCircle);drawCircle();

function calc(){
  const a=+$('a').value,b=+$('b').value;
  if(!(a>0&&b>0)){$('calc').textContent='Isi kedua sisi dengan angka lebih dari 0.';return}
  const m=Math.hypot(a,b),th=Math.atan2(a,b)*180/Math.PI;
  $('calc').innerHTML=`Sisi miring = √(${f(a)}² + ${f(b)}²) = <b>${f(m)}</b><br>
  <span class="s">sin θ = ${f(a)}/${f(m)} = <b>${f(a/m)}</b></span><br>
  <span class="c">cos θ = ${f(b)}/${f(m)} = <b>${f(b/m)}</b></span><br>
  <span class="t">tan θ = ${f(a)}/${f(b)} = <b>${f(a/b)}</b></span><br>
  Besar sudut θ ≈ <b>${f(th,2)}°</b>`;
}
$('a').addEventListener('input',calc);$('b').addEventListener('input',calc);calc();

const Q=[
 {q:'Pada segitiga siku-siku, sin θ sama dengan …',o:['depan / miring','samping / miring','depan / samping'],a:0},
 {q:'Berapa nilai cos 60°?',o:['½√3','1/2','1'],a:1},
 {q:'Jika sin θ = 5/13 dan θ lancip, maka cos θ = …',o:['12/13','5/12','8/13'],a:0},
 {q:'180° sama dengan … radian.',o:['π/2','π','2π'],a:1}
];
$('quiz').innerHTML=Q.map((x,i)=>`<div class="q"><p>${i+1}. ${x.q}</p>${x.o.map((t,j)=>`<button type="button" class="alt" data-i="${i}" data-j="${j}">${t}</button>`).join('')}<div class="fb" aria-live="polite"></div></div>`).join('');
$('quiz').addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b)return;
  const i=+b.dataset.i,j=+b.dataset.j,box=b.parentElement,ok=j===Q[i].a;
  box.querySelectorAll('button').forEach(x=>x.classList.remove('ok','no'));
  b.classList.add(ok?'ok':'no');
  box.querySelector('.fb').textContent=ok?'Benar.':'Belum tepat, coba pilihan lain.';
});
</script>
</body>
</html>
